<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A console runner, not a test framework. xunit or NUnit would be a
    test-scope dependency and so harmless to consumers, but it would mean this
    client cannot be checked without a NuGet restore and a network. `make ci`
    runs `dotnet build` and the resulting binary and nothing else, which is
    worth more than the assertions a framework would have provided.

    Targets the SDK's own runtime rather than netstandard2.0, which is a
    reference target and cannot be executed.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <RootNamespace>Mobium.Tests</RootNamespace>
    <AssemblyName>Mobium.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Mobium/Mobium.csproj" />
  </ItemGroup>

</Project>
