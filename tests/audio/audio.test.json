{
  "description": "MobiumApp's Audio Demo, heard: each test captures what the device plays and asserts it at the stop. An Android emulator only — run with --project android; iOS and phones refuse the capture.",
  "app": "dev.mobium.mobiumapp",
  "beforeEach": [
    {"scroll_to": {"target": "text=Audio Demo", "direction": "down"}},
    {"tap": "text=Audio Demo"},
    {"wait_for": {"target": "testid=audioState"}}
  ],
  "tests": [
    {"name": "the sequence is heard in order", "steps": [
      {"audio": {"action": "start"}},
      {"tap": "testid=audioSequence"},
      {"wait_for": {"target": "text=finished:", "timeout_ms": 10000}},
      {"audio": {"action": "stop", "path": "mobium-report/sequence.wav", "expect": [
        {"hz": 440, "min_ms": 1800, "max_ms": 2300},
        {"hz": 880, "min_ms": 1800, "max_ms": 2300}
      ]}}
    ]},
    {"name": "silence is heard as silence", "steps": [
      {"audio": {"action": "start"}},
      {"tap": "testid=audioSilent"},
      {"wait_for": {"target": "text=finished:", "timeout_ms": 10000}},
      {"audio": {"action": "stop", "path": "mobium-report/silence.wav", "expect": []}}
    ]}
  ]
}
