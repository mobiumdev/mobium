{
  "description": "MobiumApp's Login Demo: the negative paths, as one test over three cases, the demo account, and the fields' state as the form is filled.",
  "app": "dev.mobium.mobiumapp",
  "beforeEach": [
    {"name": "app_dialogs", "arguments": {"when": "Save Password", "press": "Not Now"},
     "description": "iOS offers to save the password after a sign-in; the rule answers it, on Android it never comes"},
    {"name": "app_tap", "arguments": {"target": "label=Login Demo"}}
  ],
  "tests": [
    {"name": "a bad sign-in is refused, and says why: ${why}",
     "description": "One test per case, Playwright's parameterized test; each names its own message under its own field.",
     "each": [
      {"why": "a wrong password", "user": "mobium", "pass": "wrongpass1", "error": "loginError",
       "message": "Incorrect username or password."},
      {"why": "a short password", "user": "mobium", "pass": "abc", "error": "passError",
       "message": "Password must be at least 6 characters."},
      {"why": "a short username", "user": "mo", "pass": "hunter2", "error": "userError",
       "message": "Username must be at least 3 characters."}
     ],
     "steps": [
      {"name": "app_fill", "arguments": {"target": "testid=username", "text": "${user}"}},
      {"name": "app_fill", "arguments": {"target": "testid=password", "text": "${pass}"}},
      {"name": "app_tap", "arguments": {"target": "testid=loginBtn"}},
      {"name": "app_wait_for", "arguments": {"target": "testid=${error}", "condition": "text",
        "text": "${message}", "exact": true}},
      {"name": "app_wait_for", "arguments": {"target": "testid=welcomeText", "condition": "hidden"}}
    ]},
    {"name": "the demo account signs in, and out", "steps": [
      {"name": "app_fill", "arguments": {"target": "testid=username", "text": "mobium"}},
      {"name": "app_fill", "arguments": {"target": "testid=password", "text": "hunter2"}},
      {"name": "app_tap", "arguments": {"target": "testid=loginBtn"}},
      {"name": "app_wait_for", "arguments": {"target": "testid=welcomeText", "timeout_ms": 15000}},
      {"name": "app_tap", "arguments": {"target": "testid=logoutBtn"}},
      {"name": "app_wait_for", "arguments": {"target": "testid=username", "condition": "value", "text": ""}}
    ]},
    {"name": "focus follows the tap, and a field holds what was typed", "steps": [
      {"name": "app_tap", "arguments": {"target": "testid=username"}},
      {"name": "app_wait_for", "arguments": {"target": "testid=username", "condition": "focused"}},
      {"name": "app_wait_for", "arguments": {"target": "testid=password", "condition": "focused", "not": true}},
      {"name": "app_type", "arguments": {"target": "testid=username", "text": "mob"}},
      {"name": "app_wait_for", "arguments": {"target": "testid=username", "condition": "value", "text": "mob"}},
      {"name": "app_wait_for", "arguments": {"target": "testid=username", "condition": "text", "text": "mobium", "not": true}}
    ]},
    {"name": "the app is in front throughout", "steps": [
      {"expect": {"tool": "app_state", "arguments": {"app": "dev.mobium.mobiumapp"}, "field": "state",
        "equals": "foreground"}},
      {"expect": {"tool": "app_current", "field": "app", "equals": "dev.mobium.mobiumapp"}}
    ]}
  ]
}
