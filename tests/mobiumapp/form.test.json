{
  "description": "MobiumApp's Form Demo: a checkbox, a radio group and a real switch, each waited on by state. Written in the step shorthand; login.test.json keeps the long form, so the suite runs both.",
  "app": "dev.mobium.mobiumapp",
  "beforeEach": [
    {"tap": "label=Form Demo"}
  ],
  "tests": [
    {"name": "a checkbox reaches the state asked for", "steps": [
      {"wait_for": {"target": "testid=termsCheck", "condition": "unchecked"}},
      {"check": "testid=termsCheck"},
      {"wait_for": {"target": "testid=termsCheck", "condition": "checked"}},
      {"wait_for": {"target": "testid=notifyCheck", "condition": "checked", "not": true}}
    ]},
    {"name": "choosing a radio clears the one before", "steps": [
      {"wait_for": {"target": "testid=planFree", "condition": "checked"}},
      {"tap": "testid=planPro"},
      {"wait_for": {"target": "testid=planPro", "condition": "checked"}},
      {"wait_for": {"target": "testid=planFree", "condition": "unchecked"}},
      {"wait_for": {"target": "role=radio", "condition": "count", "count": 3}}
    ]},
    {"name": "the dark mode switch goes on and back off", "steps": [
      {"check": "testid=darkSwitch"},
      {"wait_for": {"target": "testid=darkSwitch", "condition": "checked"}},
      {"check": {"target": "testid=darkSwitch", "checked": false}},
      {"wait_for": {"target": "testid=darkSwitch", "condition": "unchecked"}}
    ]}
  ]
}
